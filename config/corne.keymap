#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// LAYERS

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUNC    3

// MACROS

#define SUPER LC(LSHIFT)
#define SUPER2 LA(LC(LSHIFT))

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <50>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&hm RGUI SEMI>, <&kp SQT>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LCTRL TAB>, <&kp ESC>;
        };

        qtab: qtab {
            compatible = "zmk,behavior-tap-dance";
            label = "QTAB";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp Q>, <&kp TAB>;
        };

        altesc: altesc {
            compatible = "zmk,behavior-tap-dance";
            label = "ALTESC";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp LEFT_ALT>, <&kp ESCAPE>;
        };

        tdaa: tdaa {
            compatible = "zmk,behavior-tap-dance";
            label = "TDAA";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&hm LEFT_SHIFT A>, <&kp LC(A)>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-tap-dance";
            label = "NEW_BEHAVIOR";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp LS(Q)>, <&kp TAB>;
        };

        qplusctrlpluscaps: qplusctrlpluscaps {
            compatible = "zmk,behavior-tap-dance";
            label = "QPLUSCTRLPLUSCAPS";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kt LEFT_CONTROL>, <&kp CLCK>;

            tapping-term-ms = <150>;
        };

        AplusShiftplusWIN: AplusShiftplusWIN {
            compatible = "zmk,behavior-tap-dance";
            label = "APLUSSHIFTPLUSWIN";
            #binding-cells = <0>;
            bindings = <&kp A>, <&kt LEFT_SHIFT>, <&kp LEFT_GUI>;

            tapping-term-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_cword {
            timeout-ms = <50>;
            key-positions = <16 19>;
            bindings = <&caps_word>;
        };

        combo_vimwq {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&vim_quit>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <38 17>;
        };

        shift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <1 2 3>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <2 3 4>;
        };

        windows {
            bindings = <&kp LEFT_GUI>;
            key-positions = <38 5>;
        };

        ctrltab {
            bindings = <&kp LC(TAB)>;
            key-positions = <3 4 5>;
        };

        prnt {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <15 16 17>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <38 25>;
        };
    };

    macros {
        vim_quit: vim_quit {
            label = "ZM_vim_quit";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp ESC &kp COLON &kp W &kp Q>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none  &qplusctrlpluscaps  &kp W  &kp E    &kp R      &kp T            &kp Y                 &kp U  &kp I      &kp O    &kp P      &none
&none  &AplusShiftplusWIN  &kp S  &kp D    &kp F      &kp G            &kp H                 &kp J  &kp K      &kp L    &td0       &none
&none  &kp Z               &kp X  &kp C    &kp V      &kp B            &kp N                 &kp M  &kp COMMA  &kp DOT  &kp SLASH  &none
                                  &altesc  &kp SPACE  &kp BACKSPACE    &hm LEFT_SHIFT ENTER  &mo 1  &mo 2
            >;
        };

        num_layer {
            bindings = <
&none  &qtab      &kp LS(W)  &kp LS(E)  &kp LS(R)  &kp LS(T)    &kp LS(Y)             &kp LS(U)  &kp LS(I)      &kp LS(O)       &kp LS(P)      &none
&none  &tdaa      &kp LS(S)  &kp LS(D)  &kp LS(F)  &kp LS(G)    &kp LS(H)             &kp LS(J)  &kp LS(K)      &kp LS(L)       &kp LS(SLASH)  &none
&none  &kp LS(Z)  &kp LS(X)  &kp LS(C)  &kp LS(V)  &kp LS(B)    &kp LS(N)             &kp LS(M)  &kp LS(COMMA)  &kp LS(PERIOD)  &kp LS(SLASH)  &none
                             &altesc    &kp SPACE  &kp LCTRL    &hm LEFT_SHIFT ENTER  &trans     &mo 2
            >;
        };

        sym_layer {
            bindings = <
&none  &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3              &kp NUMBER_4    &kp N5             &kp NUMBER_6          &kp N7     &kp N8    &kp N9    &kp N0    &none
&none  &kp LEFT_SHIFT  &kp GRAVE       &hm C_VOL_DN C_VOLUME_UP  &kp UP_ARROW    &kp KP_MULTIPLY    &kp MINUS             &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &none
&none  &mo 3           &sk LEFT_SHIFT  &kp LEFT_ARROW            &kp DOWN_ARROW  &kp RIGHT          &kp UNDER             &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &none
                                       &altesc                   &kp SPACE       &kp BACKSPACE      &hm LEFT_SHIFT ENTER  &mo 1      &trans
            >;
        };

        func_layer {
            bindings = <
&none  &kp F1  &kp F2  &kp F3        &kp F4        &kp F5              &kp F6        &kp F7        &kp F8        &kp F9          &kp F10  &none
&none  &none   &none   &kp C_PREV    &kp C_NEXT    &kp C_PLAY_PAUSE    &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &none           &kp F11  &none
&none  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2        &bt BT_SEL 3  &bt BT_NXT    &bt BT_CLR    &bt BT_CLR_ALL  &kp F12  &none
                       &sys_reset    &trans        &bootloader         &bootloader   &mo 1         &mo 2
            >;
        };

        capital {
            bindings = <
&trans  &key_repeat  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
